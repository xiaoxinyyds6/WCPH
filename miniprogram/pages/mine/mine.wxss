.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 0;
}

/* 顶部用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.u-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 108rpx;
}

.u-avatar.guest {
  background: #E4E6EC;
}

.u-img {
  width: 100%;
  height: 100%;
}

.u-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.u-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.u-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.u-status {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.u-status.ok {
  color: #3BA05F;
}

.u-arrow {
  color: var(--text-light);
  font-size: 40rpx;
}

/* 区块标题 */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.sec-more {
  font-size: 26rpx;
  color: var(--primary);
}

/* 我的宠物大边框 */
.pet-section {
  margin-top: 24rpx;
  padding: 24rpx 24rpx 12rpx;
}

/* 单宠物卡 + 左右切换 */
.pet-slider {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.slider-arrow {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-item {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  border: 2rpx solid #EEF2F8;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FBFCFF 0%, #F5F7FE 100%);
  padding: 24rpx;
}

.pet-dots {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  padding-bottom: 8rpx;
}

.pc-head {
  display: flex;
  align-items: center;
}

.pc-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid #EEF2F8;
  box-shadow: 0 4rpx 14rpx rgba(91, 124, 250, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 96rpx;
}

.pc-img {
  width: 100%;
  height: 100%;
}

.pc-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.pc-id {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.pc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pc-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pc-arrow {
  color: #C2C6D0;
  font-size: 38rpx;
  margin-left: 12rpx;
}

.pc-stats {
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #EEF2F8;
}

.pc-stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.pc-stat + .pc-stat {
  border-left: 2rpx solid #EEF2F8;
}

.pc-stat-label {
  font-size: 20rpx;
  color: var(--text-light);
}

.pc-stat-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  padding: 0 6rpx;
}

/* 问诊记录 */
.section {
  margin-top: 24rpx;
}

.rec-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-top: 20rpx;
}

.r-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 92rpx;
  font-size: 44rpx;
}

.r-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.r-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.r-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.r-arrow {
  color: var(--text-light);
  font-size: 38rpx;
  margin-left: 12rpx;
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.logout {
  margin: 48rpx 8rpx 0;
  background: #fff;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.8;
  box-shadow: var(--shadow);
}

.logout::after {
  border: none;
}

.bottom-space {
  height: 60rpx;
}
