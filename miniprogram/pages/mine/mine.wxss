.page {
  min-height: 100vh;
  background: var(--bg);
}

/* 顶部渐变区 */
.hero {
  padding: 60rpx 32rpx 88rpx;
  background: linear-gradient(135deg, #5FA8A0 0%, #8ECAE6 100%);
}

.hero-user {
  display: flex;
  align-items: center;
}

.u-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 112rpx;
}

.u-img {
  width: 100%;
  height: 100%;
}

.u-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.u-info {
  flex: 1;
  margin-left: 26rpx;
  min-width: 0;
  color: #fff;
}

.u-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.u-status {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.75);
}

.u-arrow {
  color: rgba(255, 255, 255, 0.8);
  font-size: 40rpx;
}

/* 内容区（上移叠在渐变上） */
.body {
  margin-top: -48rpx;
  padding: 0 24rpx;
}

/* 区块标题 */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.sec-more {
  font-size: 26rpx;
  color: var(--primary);
}

/* 我的宠物 */
.pet-section {
  padding: 26rpx 24rpx 16rpx;
}

.pet-slider {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.slider-arrow {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-item {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  border: 2rpx solid #F3F8F7;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FAF8F5 0%, #FAF8F5 100%);
  padding: 24rpx;
}

.pet-dots {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  padding-bottom: 8rpx;
}

.pc-head {
  display: flex;
  align-items: center;
}

.pc-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid #F3F8F7;
  box-shadow: 0 4rpx 14rpx rgba(95, 168, 160, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 96rpx;
}

.pc-img {
  width: 100%;
  height: 100%;
}

.pc-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.pc-id {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.pc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pc-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pc-arrow {
  color: #C7D2D2;
  font-size: 38rpx;
  margin-left: 12rpx;
}

.pc-stats {
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F3F8F7;
}

.pc-stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.pc-stat + .pc-stat {
  border-left: 2rpx solid #F3F8F7;
}

.pc-stat-label {
  font-size: 20rpx;
  color: var(--text-light);
}

.pc-stat-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  padding: 0 6rpx;
}

/* 功能宫格 */
.grid {
  display: flex;
  margin-top: 24rpx;
  padding: 30rpx 12rpx;
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gi-icon {
  font-size: 44rpx;
  line-height: 1;
}

/* 我的点赞：红色爱心，比其他图标稍大 */
.heart-icon {
  color: #D9534F;
  font-size: 58rpx;
  text-shadow: 0 4rpx 10rpx rgba(217, 83, 79, 0.25);
}

.gi-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-main);
}

/* 服务列表 */
.menu {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 2rpx solid #F7F3EC;
}

.menu-item:last-child {
  border-bottom: none;
}

.mi-icon {
  width: 64rpx;
  font-size: 34rpx;
}

.mi-label {
  flex: 0 0 auto;
  font-size: 28rpx;
  color: var(--text-main);
}

.mi-sub {
  flex: 1;
  margin-left: 20rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-light);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mi-arrow {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: var(--text-light);
  font-size: 38rpx;
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.logout {
  margin: 48rpx 8rpx 0;
  background: #fff;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.8;
  box-shadow: var(--shadow);
}

.logout::after {
  border: none;
}

.bottom-space {
  height: 60rpx;
}
