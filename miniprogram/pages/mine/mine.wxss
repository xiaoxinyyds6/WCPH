.page {
  min-height: 100vh;
  background: var(--bg);
}

/* ===== 顶部渐变区 ===== */
.hero {
  position: relative;
  overflow: hidden;
  padding: 64rpx 36rpx 96rpx;
  background: linear-gradient(135deg, #4E9E96 0%, #63BDB2 55%, #8FD0CE 100%);
}

/* 装饰光斑（伪元素，无需改结构） */
.hero::before {
  content: '';
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  top: -140rpx;
  right: -70rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero::after {
  content: '';
  position: absolute;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  bottom: -30rpx;
  right: 28%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-user {
  position: relative;
  display: flex;
  align-items: center;
}

.u-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 4rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 8rpx 20rpx rgba(31, 42, 46, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 116rpx;
}

.u-img {
  width: 100%;
  height: 100%;
}

.u-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.u-info {
  flex: 1;
  margin-left: 26rpx;
  min-width: 0;
  color: #fff;
}

.u-name {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
}

.u-status {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.82);
}

.u-arrow {
  color: rgba(255, 255, 255, 0.85);
  font-size: 40rpx;
}

/* ===== 内容区（上移叠在渐变上） ===== */
.body {
  position: relative;
  margin-top: -56rpx;
  padding: 0 24rpx;
}

/* ===== 区块标题 ===== */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.sec-more {
  font-size: 25rpx;
  color: var(--primary-deep);
  padding: 8rpx 4rpx;
}

/* ===== 我的宠物 ===== */
.pet-section {
  padding: 28rpx 24rpx 16rpx;
}

.pet-slider {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.slider-arrow {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 38rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease;
}

.slider-arrow:active {
  transform: scale(0.88);
}

.pet-item {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  border: 2rpx solid var(--hairline);
  border-radius: var(--radius);
  background: linear-gradient(180deg, #FBFDFC 0%, #F6FAF9 100%);
  padding: 26rpx 24rpx;
}

.pet-dots {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  padding-bottom: 8rpx;
}

.pc-head {
  display: flex;
  align-items: center;
}

.pc-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid var(--hairline);
  box-shadow: 0 4rpx 14rpx rgba(31, 42, 46, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 96rpx;
}

.pc-img {
  width: 100%;
  height: 100%;
}

.pc-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.pc-id {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.pc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pc-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pc-arrow {
  color: #C7D2D2;
  font-size: 38rpx;
  margin-left: 12rpx;
}

.pc-stats {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--hairline);
}

.pc-stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.pc-stat + .pc-stat {
  border-left: 2rpx solid var(--hairline);
}

.pc-stat-label {
  font-size: 20rpx;
  color: var(--text-light);
}

.pc-stat-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  padding: 0 6rpx;
}

/* ===== 功能宫格：彩色图标底（大厂风格） ===== */
.grid {
  display: flex;
  margin-top: 24rpx;
  padding: 32rpx 12rpx;
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.18s ease;
}

.grid-item:active {
  transform: scale(0.92);
}

.gi-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
  background: var(--primary-soft);
}

/* 按顺序轮换柔和色板 */
.grid-item:nth-child(1) .gi-icon { background: #E8F4F3; }
.grid-item:nth-child(2) .gi-icon { background: #FFF4E0; }
.grid-item:nth-child(3) .gi-icon { background: #FDEEEE; }
.grid-item:nth-child(4) .gi-icon { background: #F0EBFB; }

/* 我的点赞：红色爱心，比其他图标稍大 */
.heart-icon {
  color: var(--danger);
  font-size: 54rpx;
}

.gi-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-main);
}

/* ===== 服务列表 ===== */
.menu {
  margin-top: 24rpx;
  padding: 10rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  border-bottom: 2rpx solid var(--hairline);
  transition: opacity 0.15s ease;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-item:last-child {
  border-bottom: none;
}

.mi-icon {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  background: var(--primary-soft);
}

.menu-item:nth-child(1) .mi-icon { background: #FFF4E0; }
.menu-item:nth-child(2) .mi-icon { background: #E8F4F3; }
.menu-item:nth-child(3) .mi-icon { background: #FDEEEE; }
.menu-item:nth-child(4) .mi-icon { background: #F0EBFB; }

.mi-label {
  flex: 0 0 auto;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.mi-sub {
  flex: 1;
  margin-left: 20rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-light);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mi-arrow {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #C7D2D2;
  font-size: 38rpx;
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.logout {
  margin: 48rpx 8rpx 0;
  background: #fff;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.8;
  box-shadow: var(--shadow);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.logout:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.bottom-space {
  height: 60rpx;
}
