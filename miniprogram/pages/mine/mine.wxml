<view class="page">
  <!-- 顶部：渐变背景 + 用户信息 -->
  <view class="hero">
    <view class="hero-user" bindtap="onUserTap">
      <view class="u-avatar">
        <image wx:if="{{logged && user.avatarUrl}}" class="u-img" src="{{user.avatarUrl}}" mode="aspectFill"></image>
        <text wx:else class="u-emoji">{{logged ? '🙂' : '👤'}}</text>
      </view>
      <view class="u-info">
        <view class="u-name">{{logged ? user.nickname : '点击登录'}}</view>
        <view class="u-status">{{logged ? (user.phone || '账号已登录') : '登录后体验完整功能'}}</view>
      </view>
      <text wx:if="{{logged}}" class="u-arrow">›</text>
    </view>
  </view>

  <view class="body">
    <!-- 我的宠物（悬浮卡片） -->
    <view class="section card pet-section">
      <view class="sec-head">
        <text class="sec-title">我的宠物</text>
        <text wx:if="{{logged}}" class="sec-more" catchtap="onAddPet">＋ 添加宠物</text>
      </view>
      <view wx:if="{{logged && pets.length}}" class="pet-slider" bindtap="onPetTap">
        <view wx:if="{{pets.length > 1}}" class="slider-arrow" catchtap="onPrevPet">‹</view>
        <view class="pet-item">
          <view class="pc-head">
            <view class="pc-avatar">
              <image wx:if="{{currentPet.avatarIsImage}}" class="pc-img" src="{{currentPet.avatar}}" mode="aspectFill"></image>
              <text wx:else class="pc-emoji">{{currentPet.avatar || '🐾'}}</text>
            </view>
            <view class="pc-id">
              <view class="pc-name">{{currentPet.name}}</view>
              <view class="pc-sub">{{currentPet.category || ''}}{{currentPet.breed ? ' · ' + currentPet.breed : ''}}{{currentPet.ageText ? ' · ' + currentPet.ageText : ''}}</view>
            </view>
            <text class="pc-arrow">›</text>
          </view>
          <view class="pc-stats">
            <view class="pc-stat">
              <view class="pc-stat-label">体重</view>
              <view class="pc-stat-value">{{currentPet.weight || '-'}}</view>
            </view>
            <view class="pc-stat">
              <view class="pc-stat-label">绝育</view>
              <view class="pc-stat-value">{{currentPet.sterilized ? '已绝育' : '未绝育'}}</view>
            </view>
            <view class="pc-stat">
              <view class="pc-stat-label">驱虫</view>
              <view class="pc-stat-value">{{currentPet.dewormed || '未知'}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{pets.length > 1}}" class="slider-arrow" catchtap="onNextPet">›</view>
      </view>
      <view wx:if="{{logged && !pets.length}}" class="empty" catchtap="onAddPet">还没有添加宠物，点击这里创建 🐱🐶</view>
      <view wx:if="{{!logged}}" class="empty" catchtap="onLoginGate">登录后管理你的宠物档案</view>
      <view wx:if="{{pets.length > 1}}" class="pet-dots">{{petIndex + 1}} / {{pets.length}}</view>
    </view>

    <!-- 功能宫格 -->
    <view class="grid card">
      <view class="grid-item" bindtap="onMyPostsTap">
        <view class="gi-icon">📝</view>
        <view class="gi-label">我的发布</view>
      </view>
      <view class="grid-item" bindtap="onFavTap">
        <view class="gi-icon">⭐</view>
        <view class="gi-label">我的收藏</view>
      </view>
      <view class="grid-item" bindtap="onLikedPostsTap">
        <view class="gi-icon heart-icon">♥</view>
        <view class="gi-label">我的点赞</view>
      </view>
      <view class="grid-item" bindtap="onHistoryTap">
        <view class="gi-icon">🕘</view>
        <view class="gi-label">历史浏览</view>
      </view>
    </view>

    <!-- 服务列表 -->
    <view class="menu card">
      <view class="menu-item" bindtap="onRemindersTap">
        <text class="mi-icon">⏰</text>
        <text class="mi-label">健康计划</text>
        <text class="mi-sub">疫苗 / 驱虫 / 洗护提醒</text>
        <text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onRecordsListTap">
        <text class="mi-icon">🩺</text>
        <text class="mi-label">问诊记录</text>
        <text class="mi-sub">历史问诊与报告</text>
        <text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onHospitals">
        <text class="mi-icon">🏥</text>
        <text class="mi-label">附近宠物医院</text>
        <text class="mi-sub">按距离排序 · 支持导航</text>
        <text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onSettingsTap">
        <text class="mi-icon">⚙️</text>
        <text class="mi-label">设置与协议</text>
        <text class="mi-arrow">›</text>
      </view>
    </view>

    <button wx:if="{{logged}}" class="logout" bindtap="onLogout">退出登录</button>
    <view class="bottom-space"></view>
  </view>
</view>
