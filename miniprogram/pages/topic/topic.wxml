<view class="page">
  <view class="card">
    <view class="label">宠物类型</view>
    <view class="kinds">
      <view
        wx:for="{{kinds}}"
        wx:key="*this"
        class="kind {{petKind === item ? 'on' : ''}}"
        data-k="{{item}}"
        bindtap="onKind"
      >{{item}}</view>
    </view>

    <view class="label">标题</view>
    <input
      class="title-input"
      value="{{title}}"
      bindinput="onTitle"
      maxlength="30"
      placeholder="一句话概括，例如：猫咪耳朵有黑褐色分泌物"
      placeholder-class="ph"
    />

    <view class="label">具体情况</view>
    <textarea
      class="excerpt"
      value="{{excerpt}}"
      bindinput="onExcerpt"
      maxlength="120"
      placeholder="发病时间、频率、精神食欲、排便情况等，越详细越容易获得有效建议"
      placeholder-class="ph"
    />
    <view class="counter">{{count}}/{{maxExcerpt}}</view>
  </view>

  <view class="notice card">
    <view class="notice-title">发布须知</view>
    <view class="notice-line">· 内容公开可见，请勿填写手机号、住址等个人信息</view>
    <view class="notice-line">· 请勿发布广告、引流或与宠物健康无关的内容</view>
    <view class="notice-line">· 社区建议不能替代执业兽医的现场诊断</view>
  </view>

  <button class="submit {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
    {{submitting ? '提交中…' : (editId ? '保存修改' : '发布求助')}}
  </button>
</view>
