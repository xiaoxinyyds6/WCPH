.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(30, 40, 80, 0.05);
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2F3A3F;
  margin-bottom: 16rpx;
}

.kinds {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.kind {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #F7F3EC;
  color: #6B7A80;
  font-size: 26rpx;
}

.kind.on {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-weight: 600;
}

.title-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
  font-size: 27rpx;
  margin-bottom: 28rpx;
}

.excerpt {
  width: 100%;
  height: 220rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #A9B6B9;
  margin-top: 10rpx;
}

.ph {
  color: #A9B6B9;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2F3A3F;
  margin-bottom: 12rpx;
}

.notice-line {
  font-size: 23rpx;
  color: #6B7A80;
  line-height: 1.8;
}

.submit {
  margin-top: 12rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.submit::after {
  border: none;
}

.submit.disabled {
  opacity: 0.6;
}
