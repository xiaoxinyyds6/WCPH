.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* 审核状态横幅（仅作者可见） */
.audit-banner {
  margin-bottom: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.audit-banner.pending {
  background: #FBF3E4;
  color: #B27B23;
}
.audit-banner.rejected {
  background: #FAEDED;
  color: var(--danger);
}

/* 作者修改帖子入口（待审核/未通过状态显示） */
.edit-entry {
  margin: 12rpx 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(95, 168, 160, 0.12);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.empty-page {
  padding-top: 200rpx;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.head {
  padding: 28rpx;
}

.h-title-line {
  display: flex;
  align-items: center;
}

.h-avatar {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
}

.h-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.h-meta {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 600;
}

.part-tag {
  display: inline-block;
  margin-left: 14rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
}

.h-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-light);
}

.h-tag {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #FBF3E2;
  color: #B8772B;
  font-size: 20rpx;
}

.h-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.5;
}

.body {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
}

.body-img {
  width: 100%;
  height: 380rpx;
  border-radius: 16rpx;
  background: #F7F3EC;
}

.body-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.actions-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;
  padding: 24rpx 0;
}

.act {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-sub);
}

.act + .act {
  border-left: 2rpx solid #F7F3EC;
}

.act.liked {
  color: var(--danger);
}

.comments {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
}

.c-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.c-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #FAF8F5;
}

.c-item:last-child {
  border-bottom: none;
}

.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c-author {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.c-time {
  font-size: 20rpx;
  color: var(--text-light);
}

.c-content {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-main);
  line-height: 1.6;
  word-break: break-all;
}

.c-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 24rpx;
}

.extra {
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.extra .btn-plain {
  margin-bottom: 24rpx;
}

.btn-danger {
  background: #fff;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.6;
  border: 2rpx solid #F5D8D6;
}

.btn-danger::after {
  border: none;
}

.disclaimer {
  text-align: center;
  color: var(--text-light);
  font-size: 22rpx;
  margin: 32rpx 24rpx;
  line-height: 1.6;
}

/* 长按评论的删除小框 */
.del-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: transparent;
}

.del-menu {
  position: fixed;
  z-index: 40;
  transform: translate(-90%, -110%);
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 36, 48, 0.2);
  padding: 8rpx 0;
}

.dm-item {
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  color: var(--danger);
}

.dm-item:active {
  background: #FAEDED;
}

/* 底部评论输入栏 */
.inputbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(31, 36, 48, 0.06);
}

.msg-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #F7F3EC;
  font-size: 28rpx;
  color: var(--text-main);
}

.ph {
  color: #C7D2D2;
}

.send-btn {
  flex: 0 0 auto;
  margin-left: 20rpx;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  background: #E3ECEA;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.send-btn.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
}
