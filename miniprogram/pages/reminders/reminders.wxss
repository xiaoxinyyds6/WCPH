.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 顶部统计条 */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.head-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.head-add {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* Tab */
.tabs {
  display: flex;
  margin-top: 24rpx;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-sub);
}

.tab.active {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

/* 提醒卡片 */
.rem-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.rem-card.expired {
  border: 2rpx solid #FAEDED;
}

.rem-card.done {
  opacity: 0.75;
}

.r-head {
  display: flex;
  align-items: center;
}

.r-emoji {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.r-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.r-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.r-title-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.r-title-line .r-title {
  flex: 0 1 auto;
}

.r-status {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.r-status.ok {
  background: #EAF4EE;
  color: #4CAF7D;
}

.r-status.skip {
  background: #F7F3EC;
  color: var(--text-sub);
}

.r-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.r-due {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 600;
}

.r-due.normal {
  color: var(--primary);
}

.r-due.danger {
  color: var(--danger);
}

/* 操作区 */
.r-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F7F3EC;
}

.act-btn {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: #F7F3EC;
  color: var(--text-sub);
  font-size: 24rpx;
  margin-left: 16rpx;
}

.act-btn.primary {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

.act-btn.danger {
  background: #FAEDED;
  color: var(--danger);
}
