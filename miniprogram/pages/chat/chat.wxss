.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* 自定义导航栏（主题蓝紫渐变） */
.navbar {
  background: linear-gradient(135deg, #6CBFB5 0%, #A78BFA 100%);
  z-index: 10;
}

.nav-inner {
  display: flex;
  align-items: center;
  height: 44px;
  padding: 0 12rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  font-size: 44rpx;
  line-height: 64rpx;
  text-align: center;
  color: #fff;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.nav-holder {
  width: 64rpx;
  height: 64rpx;
}

.nav-actions {
  display: flex;
  align-items: center;
}

.nav-act {
  width: 54rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
}

.nav-title {
  padding: 0 8rpx;
}

/* 会话选择面板（档案袋） */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 24, 40, 0.45);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 72vh;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  margin-bottom: 20rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2F3A3F;
}

.sheet-sub {
  font-size: 23rpx;
  color: #6B7A80;
  margin-top: 6rpx;
}

.sheet-new {
  background: linear-gradient(135deg, #6CBFB5 0%, #A78BFA 100%);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.sheet-list {
  max-height: 44vh;
}

.sheet-item {
  padding: 22rpx;
  border: 2rpx solid #F3F8F7;
  border-radius: 20rpx;
  margin-bottom: 14rpx;
}

.si-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.si-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #2F3A3F;
}

.si-badge {
  font-size: 20rpx;
  color: #5FA8A0;
  background: #EDF5F3;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 12rpx;
}

.si-sub {
  font-size: 22rpx;
  color: #6B7A80;
  margin-top: 8rpx;
}

.sheet-empty {
  text-align: center;
  color: #A9B6B9;
  font-size: 24rpx;
  padding: 30rpx;
}

/* 顶部 */
.topbar {
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 5;
}

/* 单宠物信息卡 + 左右切换箭头 */
.pet-slider {
  display: flex;
  align-items: center;
}

.slider-arrow {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-card {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  padding: 24rpx;
  border: 2rpx solid #F3F8F7;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FAF8F5 0%, #FAF8F5 100%);
}

.pc-head {
  display: flex;
  align-items: center;
}

.pc-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid #F3F8F7;
  box-shadow: 0 4rpx 14rpx rgba(95, 168, 160, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 96rpx;
}

.pc-img {
  width: 100%;
  height: 100%;
}

.pc-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.pc-id {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.pc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pc-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pc-stats {
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F3F8F7;
}

.pc-stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.pc-stat + .pc-stat {
  border-left: 2rpx solid #F3F8F7;
}

.pc-stat-label {
  font-size: 20rpx;
  color: var(--text-light);
}

.pc-stat-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  padding: 0 6rpx;
}

.topbar-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-light);
}

.add-link {
  font-size: 26rpx;
  color: var(--primary);
}

/* 调试信息（定位宠物加载问题时显示） */
.debug-info {
  flex-basis: 100%;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #C7D2D2;
}

.saved-tag {
  font-size: 22rpx;
  color: #4CAF7D;
  background: #EAF4EE;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

/* 消息 */
.msg-list {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 24rpx 12rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.msg.user {
  flex-direction: row-reverse;
}

.avatar-dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex: 0 0 68rpx;
}

.bubble-wrap {
  max-width: 74%;
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
}

.msg.user .bubble-wrap {
  align-items: flex-end;
}

.bubble {
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

/* 报告下方「补充问诊」入口 */
.supplement-btn {
  display: inline-block;
  margin-top: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 24rpx;
  font-weight: 600;
}

.msg.ai .bubble {
  background: #fff;
  color: var(--text-main);
  border-top-left-radius: 6rpx;
  box-shadow: var(--shadow);
}

.msg.user .bubble {
  background: linear-gradient(135deg, #6CBFB5 0%, #A78BFA 100%);
  color: #fff;
  border-top-right-radius: 6rpx;
}

.time {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 10rpx;
}

.typing .dot {
  color: var(--text-light);
  font-size: 22rpx;
  margin-right: 6rpx;
  animation: blink 1.2s infinite;
}

.typing .dot:nth-child(2) { animation-delay: 0.2s; }
.typing .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 60%, 100% { opacity: 0.25; }
  30% { opacity: 1; }
}

.bottom-anchor {
  height: 12rpx;
}

/* 快捷提问 */
.quick-bar {
  white-space: nowrap;
  padding: 12rpx 24rpx 8rpx;
  background: #fff;
}

.quick-chip {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 26rpx;
}

/* 拍摄提示 */
.shoot-tip {
  padding: 0 28rpx 10rpx;
  background: #fff;
  color: #6B7A80;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 输入栏 */
.inputbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #F7F3EC;
}

.camera-btn {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  border-radius: 50%;
  background: #F7F3EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
}

.msg-input {
  flex: 1;
  height: 76rpx;
  background: #F7F3EC;
  border-radius: 999rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.ph {
  color: #C7D2D2;
}

.send-btn {
  flex: 0 0 auto;
  margin-left: 20rpx;
  padding: 0 34rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #E3ECEA;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.send-btn.active {
  background: linear-gradient(135deg, #6CBFB5 0%, #A78BFA 100%);
}

.inputbar .msg-input {
  flex: 1;
  min-width: 0;
}

/* 待发送附件预览 */
.attach-bar {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 24rpx 0;
}

.attach-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 16rpx 12rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.attach-img {
  width: 100%;
  height: 100%;
}

/* 附件栏圆形加号：继续添加图片/视频 */
.attach-add {
  width: 88rpx;
  height: 88rpx;
  margin: 0 0 12rpx 0;
  align-self: center;
  border-radius: 50%;
  border: 2rpx dashed #8ECAE6;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-chip {
  background: #2F3A3F;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.video-chip-icon {
  font-size: 40rpx;
}

.video-chip-text {
  font-size: 20rpx;
  color: #fff;
  margin-top: 4rpx;
}

.attach-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 0 16rpx;
}

/* 用户消息媒体 */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.media-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin: 0 12rpx 12rpx 0;
  box-shadow: var(--shadow);
}

.media-video {
  width: 380rpx;
  height: 300rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

/* 紧急程度分级预警横幅 */
.urgency {
  border-radius: 18rpx 18rpx 6rpx 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.urgency-head {
  display: flex;
  align-items: center;
}

.urgency-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.urgency-label {
  font-size: 28rpx;
  font-weight: 700;
}

.urgency.red {
  background: linear-gradient(135deg, #FAEDED 0%, #F5D8D6 100%);
  border: 2rpx solid #E5A5A3;
}

.urgency.red .urgency-label {
  color: #D9534F;
}

/* 红色预警：跳转附近医院的小按钮（预警标题右侧） */
.urgency-hosp {
  flex: 0 0 auto;
  margin-left: auto;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #E5A5A3;
  color: #D9534F;
  font-size: 22rpx;
  font-weight: 600;
}

.urgency-hosp:active {
  background: #FAEDED;
}

.urgency.yellow {
  background: linear-gradient(135deg, #FBF3E2 0%, #FBF3E2 100%);
  border: 2rpx solid #F2CFA0;
}

.urgency.yellow .urgency-label {
  color: #B8772B;
}

.urgency.green {
  background: linear-gradient(135deg, #EAF4EE 0%, #D8EEE2 100%);
  border: 2rpx solid #BFE3D2;
}

.urgency.green .urgency-label {
  color: #4CAF7D;
}

.urgency-call {
  margin-top: 14rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D9534F 0%, #D9534F 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(255, 90, 95, 0.35);
}

.urgency-call:active {
  opacity: 0.85;
}

.call-icon {
  margin-right: 8rpx;
}
