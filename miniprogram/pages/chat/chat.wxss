.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* 顶部 */
.topbar {
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 5;
}

/* 单宠物信息卡 + 左右切换箭头 */
.pet-slider {
  display: flex;
  align-items: center;
}

.slider-arrow {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-card {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  padding: 24rpx;
  border: 2rpx solid #EEF2F8;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FBFCFF 0%, #F5F7FE 100%);
}

.pc-head {
  display: flex;
  align-items: center;
}

.pc-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid #EEF2F8;
  box-shadow: 0 4rpx 14rpx rgba(91, 124, 250, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 96rpx;
}

.pc-img {
  width: 100%;
  height: 100%;
}

.pc-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.pc-id {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.pc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.pc-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pc-stats {
  display: flex;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #EEF2F8;
}

.pc-stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.pc-stat + .pc-stat {
  border-left: 2rpx solid #EEF2F8;
}

.pc-stat-label {
  font-size: 20rpx;
  color: var(--text-light);
}

.pc-stat-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  padding: 0 6rpx;
}

.topbar-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-light);
}

.add-link {
  font-size: 26rpx;
  color: var(--primary);
}

.saved-tag {
  font-size: 22rpx;
  color: #2BB673;
  background: #E7F7EF;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

/* 消息 */
.msg-list {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 24rpx 12rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.msg.user {
  flex-direction: row-reverse;
}

.avatar-dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex: 0 0 68rpx;
}

.bubble-wrap {
  max-width: 74%;
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
}

.msg.user .bubble-wrap {
  align-items: flex-end;
}

.bubble {
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

.msg.ai .bubble {
  background: #fff;
  color: var(--text-main);
  border-top-left-radius: 6rpx;
  box-shadow: var(--shadow);
}

.msg.user .bubble {
  background: linear-gradient(135deg, #6C8CFF 0%, #9B7BFF 100%);
  color: #fff;
  border-top-right-radius: 6rpx;
}

.time {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 10rpx;
}

.typing .dot {
  color: var(--text-light);
  font-size: 22rpx;
  margin-right: 6rpx;
  animation: blink 1.2s infinite;
}

.typing .dot:nth-child(2) { animation-delay: 0.2s; }
.typing .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 60%, 100% { opacity: 0.25; }
  30% { opacity: 1; }
}

.bottom-anchor {
  height: 12rpx;
}

/* 输入栏 */
.inputbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #F0F1F5;
}

.msg-input {
  flex: 1;
  height: 76rpx;
  background: #F2F3F7;
  border-radius: 999rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.ph {
  color: #C2C6D0;
}

.send-btn {
  flex: 0 0 auto;
  margin-left: 20rpx;
  padding: 0 34rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #E2E5EE;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.send-btn.active {
  background: linear-gradient(135deg, #6C8CFF 0%, #9B7BFF 100%);
}
