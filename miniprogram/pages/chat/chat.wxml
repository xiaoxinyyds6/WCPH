<view class="chat">
  <!-- 顶部宠物信息 -->
  <view class="topbar">
    <view wx:if="{{currentPet._id}}" class="pet-slider">
      <view wx:if="{{pets.length > 1}}" class="slider-arrow" bindtap="onPrevPet">‹</view>
      <view class="pet-card">
        <view class="pc-head">
          <view class="pc-avatar">
            <image wx:if="{{currentPet.avatarIsImage}}" class="pc-img" src="{{currentPet.avatar}}" mode="aspectFill"></image>
            <text wx:else class="pc-emoji">{{currentPet.avatar || '🐾'}}</text>
          </view>
          <view class="pc-id">
            <view class="pc-name ellipsis">{{currentPet.name}}</view>
            <view class="pc-sub ellipsis">{{currentPet.category || '—'}}{{currentPet.breed ? ' · ' + currentPet.breed : ''}}</view>
          </view>
          <text wx:if="{{savedId}}" class="saved-tag">已存记录</text>
        </view>
        <view class="pc-stats">
          <view class="pc-stat">
            <view class="pc-stat-label">岁数</view>
            <view class="pc-stat-value">{{currentPet.ageText || '—'}}</view>
          </view>
          <view class="pc-stat">
            <view class="pc-stat-label">体重</view>
            <view class="pc-stat-value">{{currentPet.weight != null ? currentPet.weight + 'kg' : '—'}}</view>
          </view>
          <view class="pc-stat">
            <view class="pc-stat-label">绝育</view>
            <view class="pc-stat-value">{{currentPet.neutered || '—'}}</view>
          </view>
          <view class="pc-stat">
            <view class="pc-stat-label">体态</view>
            <view class="pc-stat-value">{{currentPet.body || '—'}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{pets.length > 1}}" class="slider-arrow" bindtap="onNextPet">›</view>
    </view>

    <view wx:else class="topbar-empty">
      <text class="empty-text">还没有宠物，问诊前请先添加宠物信息</text>
      <text class="add-link" bindtap="onAddPet">去添加</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view wx:for="{{messages}}" wx:key="_k" id="msg-{{item._k}}" class="msg {{item.role}}">
      <view class="avatar-dot">{{item.role === 'ai' ? '🤖' : '🙂'}}</view>
      <view class="bubble-wrap">
        <text class="bubble" user-select>{{item.content}}</text>
        <text class="time">{{item.timeText}}</text>
      </view>
    </view>

    <view wx:if="{{sending}}" class="msg ai">
      <view class="avatar-dot">🤖</view>
      <view class="bubble-wrap">
        <view class="bubble typing">
          <text class="dot">●</text><text class="dot">●</text><text class="dot">●</text>
        </view>
      </view>
    </view>

    <view id="bottom-anchor" class="bottom-anchor"></view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="inputbar">
    <input
      class="msg-input"
      value="{{inputValue}}"
      bindinput="onInput"
      bindconfirm="send"
      confirm-type="send"
      placeholder="请详细描述宠物的症状…"
      placeholder-class="ph"
      adjust-position="{{true}}"
      cursor-spacing="20"
    />
    <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="send">发送</view>
  </view>
</view>
