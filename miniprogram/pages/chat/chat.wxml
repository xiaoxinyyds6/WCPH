<view class="chat">
  <!-- 自定义导航栏（拦截返回：未发送附件询问保存） -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner" style="height: {{navH}}px; padding-right: {{navPadRight}}px;">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title ellipsis">{{sessionTitle || 'AI问诊'}}</text>
      <view class="nav-actions">
        <view class="nav-act" bindtap="onOpenPicker">📁</view>
        <view class="nav-act" bindtap="onRenameSession">✏️</view>
        <view class="nav-act" bindtap="onPublishSession">📤</view>
      </view>
    </view>
  </view>

  <!-- 顶部宠物信息 -->
  <view class="topbar">
    <view wx:if="{{currentPet._id}}" class="pet-slider">
      <view wx:if="{{pets.length > 1}}" class="slider-arrow" bindtap="onPrevPet">‹</view>
      <view class="pet-card">
        <view class="pc-head">
          <view class="pc-avatar">
            <image wx:if="{{currentPet.avatarIsImage}}" class="pc-img" src="{{currentPet.avatar}}" mode="aspectFill"></image>
            <text wx:else class="pc-emoji">{{currentPet.avatar || '🐾'}}</text>
          </view>
          <view class="pc-id">
            <view class="pc-name ellipsis">{{currentPet.name}}</view>
            <view class="pc-sub ellipsis">{{currentPet.category || '—'}}{{currentPet.breed ? ' · ' + currentPet.breed : ''}}</view>
          </view>
          <text wx:if="{{sessionId}}" class="saved-tag">{{published ? '已发布' : '已存记录'}}</text>
        </view>
        <view class="pc-stats">
          <view class="pc-stat">
            <view class="pc-stat-label">岁数</view>
            <view class="pc-stat-value">{{currentPet.ageText || '—'}}</view>
          </view>
          <view class="pc-stat">
            <view class="pc-stat-label">体重</view>
            <view class="pc-stat-value">{{currentPet.weight != null ? currentPet.weight + 'kg' : '—'}}</view>
          </view>
          <view class="pc-stat">
            <view class="pc-stat-label">绝育</view>
            <view class="pc-stat-value">{{currentPet.neutered || '—'}}</view>
          </view>
          <view class="pc-stat">
            <view class="pc-stat-label">体态</view>
            <view class="pc-stat-value">{{currentPet.body || '—'}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{pets.length > 1}}" class="slider-arrow" bindtap="onNextPet">›</view>
    </view>

    <view wx:else class="topbar-empty">
      <text class="empty-text">{{petLoadError ? '宠物加载失败，请检查网络后重试' : '还没有宠物，问诊前请先添加宠物信息'}}</text>
      <text wx:if="{{petLoadError}}" class="add-link" bindtap="onRetryPets">点击重试</text>
      <text wx:else class="add-link" bindtap="onAddPet">去添加</text>
      <text class="debug-info">debug: pets={{pets.length}} state={{loadState}}</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view wx:for="{{messages}}" wx:for-index="idx" wx:key="_k" id="msg-{{item._k}}" class="msg {{item.role}}">
      <view class="avatar-dot">{{item.role === 'ai' ? '🤖' : '🙂'}}</view>
      <view class="bubble-wrap">
        <!-- 紧急程度分级预警横幅 -->
        <view wx:if="{{item.level}}" class="urgency {{item.level}}">
          <view class="urgency-head">
            <text class="urgency-icon">{{item.level === 'red' ? '🚨' : item.level === 'yellow' ? '⚠️' : '🌿'}}</text>
            <text class="urgency-label">{{item.level === 'red' ? '紧急 · 建议立刻送医' : item.level === 'yellow' ? '关注 · 建议观察' : '轻症 · 居家护理'}}</text>
            <text wx:if="{{item.level === 'red'}}" class="urgency-hosp" bindtap="onNearbyHospitals">🏥 附近医院</text>
          </view>
          <view wx:if="{{item.level === 'red'}}" class="urgency-call" bindtap="onCallHospital">
            <text class="call-icon">📞</text>
            <text>一键拨打附近宠物医院电话</text>
          </view>
        </view>

        <!-- 用户消息：图片/视频 -->
        <view wx:if="{{item.images.length}}" class="media-grid">
          <image
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:key="*this"
            class="media-img"
            src="{{img}}"
            mode="aspectFill"
            data-src="{{img}}"
            data-urls="{{item.images}}"
            bindtap="onPreviewImage"
          />
        </view>
        <video wx:if="{{item.video}}" class="media-video" src="{{item.video}}" controls object-fit="contain"></video>

        <text wx:if="{{item.content}}" class="bubble" user-select>{{item.content}}</text>

        <!-- 报告下方的补充问诊入口：跳转至 AI 文字问诊界面 -->
        <view
          wx:if="{{item.role === 'ai' && item.level && idx === messages.length - 1}}"
          class="supplement-btn"
          bindtap="onSupplementText"
        >💬 补充问诊 · 文字继续追问</view>

        <text class="time">{{item.timeText}}</text>
      </view>
    </view>

    <view wx:if="{{sending}}" class="msg ai">
      <view class="avatar-dot">🤖</view>
      <view class="bubble-wrap">
        <view class="bubble typing">
          <text class="dot">●</text><text class="dot">●</text><text class="dot">●</text>
        </view>
      </view>
    </view>

    <view id="bottom-anchor" class="bottom-anchor"></view>
  </scroll-view>

  <!-- 待发送附件预览 -->
  <view wx:if="{{pendingImages.length || pendingVideo}}" class="attach-bar">
    <view wx:for="{{pendingImages}}" wx:key="*this" class="attach-item">
      <image class="attach-img" src="{{item}}" mode="aspectFill"></image>
      <view class="attach-del" data-i="{{index}}" catchtap="onRemoveImage">✕</view>
    </view>
    <view wx:if="{{pendingVideo}}" class="attach-item video-chip">
      <text class="video-chip-icon">🎬</text>
      <text class="video-chip-text">视频</text>
      <view class="attach-del" catchtap="onRemoveVideo">✕</view>
    </view>
    <view class="attach-add" bindtap="onAddMore">＋</view>
  </view>

  <!-- 快捷提问 -->
  <scroll-view wx:if="{{messages.length <= 1}}" class="quick-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view wx:for="{{quickQuestions}}" wx:key="*this" class="quick-chip" bindtap="onQuickQuestion" data-q="{{item}}">{{item}}</view>
  </scroll-view>

  <!-- 拍摄提示 -->
  <view wx:if="{{messages.length <= 1 && !pendingImages.length}}" class="shoot-tip">📷 拍摄建议：自然光下对准患处，距离 15–30 厘米，关闭美颜滤镜</view>

  <!-- 会话选择：新建档案袋 或 继续历史问诊 -->
  <view wx:if="{{showSessionPicker}}" class="sheet-mask" catchtap="onClosePicker">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-title">开始问诊</view>
        <view class="sheet-sub">每次问诊都是一个独立档案袋，可随时回来继续</view>
      </view>
      <view class="sheet-new" bindtap="onCreateSession">＋ 新建问诊记录</view>
      <scroll-view class="sheet-list" scroll-y>
        <view wx:for="{{sessions}}" wx:key="_id" class="sheet-item" data-id="{{item._id}}" bindtap="onPickSession">
          <view class="si-top">
            <text class="si-title ellipsis">{{item.title}}</text>
            <text wx:if="{{item.published}}" class="si-badge">已发布</text>
          </view>
          <view class="si-sub">{{item.petName || '未指定宠物'}} · {{item.timeText}} · {{item.count}} 条对话</view>
        </view>
        <view wx:if="{{loadingSessions}}" class="sheet-empty">加载中…</view>
        <view wx:elif="{{!sessions.length}}" class="sheet-empty">还没有历史问诊记录</view>
      </scroll-view>
    </view>
  </view>

  <!-- 输入栏 -->
  <view class="inputbar">
    <view class="camera-btn" bindtap="onCameraConsult">📷</view>
    <input
      class="msg-input"
      value="{{inputValue}}"
      bindinput="onInput"
      bindconfirm="send"
      confirm-type="send"
      placeholder="描述宠物症状…"
      placeholder-class="ph"
      adjust-position="{{true}}"
      cursor-spacing="20"
    />
    <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="send">发送</view>
  </view>
</view>
