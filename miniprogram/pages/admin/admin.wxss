.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.tabs {
  display: flex;
  padding: 8rpx;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 0;
  border-radius: 20rpx;
  /* 6 个标签并排，缩小字号避免换行 */
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 导航栏数字徽标：红色圆框，文字在上数字在下 */
.tab-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #D9534F;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  font-weight: 600;
}

/* 无数字 tab 的透明占位，保证所有标签文字等高对齐 */
.tab-badge.ghost {
  background: transparent;
  color: transparent;
  min-width: 22rpx;
  padding: 0;
}

.tab.active {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

.a-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
}

.a-head {
  display: flex;
  align-items: center;
}

.a-emoji {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  border-radius: 20rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.a-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.a-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.a-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.a-status {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #FBF3E2;
  color: #B8772B;
  font-size: 20rpx;
}

.a-status.ok {
  background: #EAF4EE;
  color: #4CAF7D;
}

.a-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F7F3EC;
}

/* 知识条目内容预览（最多两行） */
.a-content {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.a-btn {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: #F7F3EC;
  color: var(--text-sub);
  font-size: 24rpx;
  margin-left: 16rpx;
}

.a-btn.primary {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

.a-btn.danger {
  background: #FAEDED;
  color: var(--danger);
}

.a-btn.pass {
  background: #EAF4EE;
  color: #4CAF7D;
  font-weight: 600;
}

/* 审核卡片中的帖子正文预览 */
.audit-excerpt {
  margin: 12rpx 0 4rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.6;
  word-break: break-all;
}

/* 账号管理表单 */
.acc-form {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
}

.acc-form-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.acc-field {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 2rpx solid #F7F3EC;
}

/* 官方好帖：物种选择 */
.kind-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 0 8rpx;
}

.kind-chip {
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  background: #F7F3EC;
  color: var(--text-sub);
  font-size: 26rpx;
}

.kind-chip.active {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

/* 官方好帖：正文 */
.off-textarea {
  width: 100%;
  min-height: 200rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FAF8F5;
  font-size: 27rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.acc-label {
  width: 120rpx;
  flex: 0 0 120rpx;
  font-size: 27rpx;
  color: var(--text-sub);
}

.acc-input {
  flex: 1;
  font-size: 28rpx;
}

.ph {
  color: #C7D2D2;
}

.acc-add {
  width: 100%;
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

/* 数据概览 */
.stats-grid {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0;
}

.stat-cell {
  width: 50%;
  text-align: center;
  padding: 24rpx 0;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 28rpx 8rpx 8rpx;
}

/* 无权限提示 */
.go-login {
  margin-top: 32rpx;
  width: 320rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

.logout {
  margin: 48rpx 8rpx 0;
  background: #fff;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.8;
  box-shadow: var(--shadow);
}

.logout::after {
  border: none;
}
