<view class="page">
  <view wx:if="{{!isAdmin && !loading}}" class="empty card">
    <view>无管理员权限，本页面仅管理员可见</view>
    <button class="btn-plain go-login" bindtap="goAdminLogin">前往管理员登录</button>
  </view>

  <block wx:else>
    <view class="tabs card">
      <view class="tab {{tab === 'accounts' ? 'active' : ''}}" data-tab="accounts" bindtap="onTab">
        <view class="tab-label">账号管理</view>
        <view class="tab-badge ghost">0</view>
      </view>
      <view class="tab {{tab === 'posts' ? 'active' : ''}}" data-tab="posts" bindtap="onTab">
        <view class="tab-label">帖子管理</view>
        <view wx:if="{{posts.length}}" class="tab-badge">{{posts.length}}</view>
        <view wx:else class="tab-badge ghost">0</view>
      </view>
      <view class="tab {{tab === 'audit' ? 'active' : ''}}" data-tab="audit" bindtap="onTab">
        <view class="tab-label">审核</view>
        <view wx:if="{{pendingPosts.length}}" class="tab-badge">{{pendingPosts.length}}</view>
        <view wx:else class="tab-badge ghost">0</view>
      </view>
      <view class="tab {{tab === 'reports' ? 'active' : ''}}" data-tab="reports" bindtap="onTab">
        <view class="tab-label">举报处理</view>
        <view wx:if="{{reports.length}}" class="tab-badge">{{reports.length}}</view>
        <view wx:else class="tab-badge ghost">0</view>
      </view>
      <view class="tab {{tab === 'kb' ? 'active' : ''}}" data-tab="kb" bindtap="onTab">
        <view class="tab-label">知识库</view>
        <view class="tab-badge ghost">0</view>
      </view>
      <view class="tab {{tab === 'stats' ? 'active' : ''}}" data-tab="stats" bindtap="onTab">
        <view class="tab-label">数据概览</view>
        <view class="tab-badge ghost">0</view>
      </view>
    </view>

    <!-- 账号管理 -->
    <block wx:if="{{tab === 'accounts'}}">
      <view class="acc-form card">
        <view class="acc-form-title">添加账号</view>
        <view class="acc-field">
          <text class="acc-label">手机号</text>
          <input class="acc-input" type="number" maxlength="11" placeholder="11位手机号" placeholder-class="ph" value="{{newAccount.username}}" data-key="username" bindinput="onAccountInput" />
        </view>
        <view class="acc-field">
          <text class="acc-label">密码</text>
          <input class="acc-input" password="{{!showAccPwd}}" maxlength="14" placeholder="8-14位，含英文和数字" placeholder-class="ph" value="{{newAccount.password}}" data-key="password" bindinput="onAccountInput" />
          <text class="pwd-eye" bindtap="toggleAccPwd">{{showAccPwd ? '🙈' : '👁'}}</text>
        </view>
        <view wx:if="{{accPwdStrength === 'medium'}}" class="pwd-strength warn">⚠️ 该密码安全性一般</view>
        <view wx:if="{{accPwdStrength === 'strong'}}" class="pwd-strength good">✅ 该密码的安全性很可靠！</view>
        <view class="acc-field">
          <text class="acc-label">昵称</text>
          <input class="acc-input" placeholder="选填" placeholder-class="ph" value="{{newAccount.nickname}}" data-key="nickname" bindinput="onAccountInput" />
        </view>
        <button class="btn-primary acc-add" loading="{{addingAccount}}" bindtap="onAddAccount">添加账号</button>
      </view>

      <view wx:if="{{loadingAccounts}}" class="empty card">加载中…</view>
      <block wx:else>
        <view class="a-card card" wx:for="{{accounts}}" wx:key="_id">
          <view class="a-head">
            <view class="a-info">
              <view class="a-title ellipsis">{{item.username}}{{item.nickname ? '（' + item.nickname + '）' : ''}}</view>
              <view class="a-sub">创建于 {{item.timeText}}</view>
            </view>
          </view>
          <view class="a-actions">
            <text class="a-btn danger" data-id="{{item._id}}" bindtap="onRemoveAccount">删除</text>
          </view>
        </view>
        <view wx:if="{{!accounts.length}}" class="empty card">暂无账号，请在上方添加</view>
      </block>
    </block>

    <!-- 帖子管理 -->
    <block wx:elif="{{tab === 'posts'}}">
      <!-- 发布官方好帖 -->
      <view class="acc-form card">
        <view class="acc-form-title">📢 发布官方好帖</view>
        <view class="kind-chips">
          <view
            wx:for="{{petKinds}}"
            wx:key="*this"
            class="kind-chip {{officialForm.petKind === item ? 'active' : ''}}"
            data-kind="{{item}}"
            bindtap="onOffKind"
          >{{item}}</view>
        </view>
        <view class="acc-field">
          <text class="acc-label">品种</text>
          <input class="acc-input" placeholder="选填，默认“通用”" placeholder-class="ph" value="{{officialForm.petBreed}}" data-key="petBreed" bindinput="onOffInput" />
        </view>
        <view class="acc-field">
          <text class="acc-label">标题</text>
          <input class="acc-input" maxlength="40" placeholder="帖子标题" placeholder-class="ph" value="{{officialForm.title}}" data-key="title" bindinput="onOffInput" />
        </view>
        <textarea
          class="off-textarea"
          maxlength="500"
          placeholder="正文内容（养护小知识等）"
          placeholder-class="ph"
          value="{{officialForm.excerpt}}"
          data-key="excerpt"
          bindinput="onOffInput"
        ></textarea>
        <button class="btn-primary acc-add" loading="{{publishingOfficial}}" bindtap="onPublishOfficial">发布</button>
      </view>

      <view class="sec-title">全部帖子</view>
      <view wx:if="{{loading}}" class="empty card">加载中…</view>
      <block wx:else>
        <view class="a-card card" wx:for="{{posts}}" wx:key="_id">
          <view class="a-head">
            <text class="a-emoji">{{item.kindEmoji}}</text>
            <view class="a-info">
              <view class="a-title ellipsis">{{item.title}}</view>
              <view class="a-sub">{{item.petKind}}{{item.petBreed ? ' · ' + item.petBreed : ''}} · {{item.timeText}}</view>
            </view>
          </view>
          <view class="a-actions">
            <text class="a-btn danger" data-id="{{item._id}}" bindtap="onRemovePost">下架</text>
          </view>
        </view>
        <view wx:if="{{!posts.length}}" class="empty card">暂无帖子</view>
      </block>
    </block>

    <!-- 帖子审核：用户发帖需管理员同意后才展示 -->
    <block wx:elif="{{tab === 'audit'}}">
      <view wx:if="{{loadingAudit}}" class="empty card">加载中…</view>
      <block wx:else>
        <view class="sec-title">待审核帖子（{{pendingPosts.length}}）</view>
        <view class="a-card card" wx:for="{{pendingPosts}}" wx:key="_id">
          <view class="a-head">
            <text class="a-emoji">{{item.kindEmoji}}</text>
            <view class="a-info">
              <view class="a-title ellipsis">{{item.title}}</view>
              <view class="a-sub">{{item.petKind}}{{item.petBreed ? ' · ' + item.petBreed : ''}} · {{item.timeText}}</view>
            </view>
          </view>
          <view class="audit-excerpt">{{item.excerpt}}</view>
          <view class="a-actions">
            <text class="a-btn danger" data-id="{{item._id}}" bindtap="onRejectPost">拒绝发布</text>
            <text class="a-btn pass" data-id="{{item._id}}" bindtap="onApprovePost">同意发布</text>
          </view>
        </view>
        <view wx:if="{{!pendingPosts.length}}" class="empty card">没有待审核的帖子 🎉</view>
      </block>
    </block>

    <!-- 举报处理 -->
    <block wx:elif="{{tab === 'reports'}}">
      <view wx:if="{{loading}}" class="empty card">加载中…</view>
      <block wx:else>
        <view class="a-card card" wx:for="{{reports}}" wx:key="_id">
          <view class="a-head">
            <view class="a-info">
              <view class="a-title ellipsis">{{item.type}}{{item.reason ? '：' + item.reason : ''}}</view>
              <view class="a-sub">被举报帖：{{item.postTitle || '（已删除）'}} · {{item.timeText}}</view>
            </view>
            <text class="a-status {{item.status === 'handled' ? 'ok' : ''}}">{{item.statusText}}</text>
          </view>
          <view class="a-actions">
            <text wx:if="{{item.postId && item.status !== 'handled'}}" class="a-btn danger" data-id="{{item._id}}" bindtap="onRemoveReportedPost">下架帖子</text>
            <text wx:if="{{item.status !== 'handled'}}" class="a-btn primary" data-id="{{item._id}}" bindtap="onHandleReport">标记已处理</text>
          </view>
        </view>
        <view wx:if="{{!reports.length}}" class="empty card">暂无举报</view>
      </block>
    </block>

    <!-- 知识库管理（RAG 私有知识库） -->
    <block wx:elif="{{tab === 'kb'}}">
      <view class="acc-form card">
        <view class="acc-form-title">📚 添加知识条目</view>
        <view class="acc-field">
          <text class="acc-label">标题</text>
          <input class="acc-input" maxlength="40" placeholder="如：幼犬疫苗接种时间表" placeholder-class="ph" value="{{kbForm.title}}" data-key="title" bindinput="onKbInput" />
        </view>
        <view class="acc-field">
          <text class="acc-label">关键词</text>
          <input class="acc-input" maxlength="50" placeholder="选填，空格分隔，如：疫苗 幼犬" placeholder-class="ph" value="{{kbForm.tags}}" data-key="tags" bindinput="onKbInput" />
        </view>
        <textarea
          class="off-textarea"
          maxlength="2000"
          placeholder="知识内容（AI 问诊时会检索这些资料作为回答依据）"
          placeholder-class="ph"
          value="{{kbForm.content}}"
          data-key="content"
          bindinput="onKbInput"
        ></textarea>
        <button class="btn-primary acc-add" loading="{{addingKb}}" bindtap="onAddKb">添加</button>
      </view>

      <view class="sec-title">知识条目 {{kbDocs.length}}</view>
      <view wx:if="{{loadingKb}}" class="empty card">加载中…</view>
      <block wx:else>
        <view class="a-card card" wx:for="{{kbDocs}}" wx:key="_id">
          <view class="a-head">
            <view class="a-info">
              <view class="a-title ellipsis">{{item.title}}</view>
              <view class="a-sub">{{item.tags || '无关键词'}} · {{item.timeText}}{{item.seeded ? ' · 内置' : ''}}</view>
            </view>
          </view>
          <view class="a-content">{{item.content}}</view>
          <view class="a-actions">
            <text class="a-btn danger" data-id="{{item._id}}" bindtap="onRemoveKb">删除</text>
          </view>
        </view>
        <view wx:if="{{!kbDocs.length}}" class="empty card">暂无知识条目，AI 首次问诊时会自动内置常见养护知识</view>
      </block>
    </block>

    <!-- 数据概览 -->
    <block wx:else>
      <view wx:if="{{loadingStats}}" class="empty card">加载中…</view>
      <block wx:else>
        <view class="stats-grid card">
          <view class="stat-cell">
            <view class="stat-num">{{stats.users}}</view>
            <view class="stat-label">用户</view>
          </view>
          <view class="stat-cell">
            <view class="stat-num">{{stats.pets}}</view>
            <view class="stat-label">宠物档案</view>
          </view>
          <view class="stat-cell">
            <view class="stat-num">{{stats.records}}</view>
            <view class="stat-label">问诊记录</view>
          </view>
          <view class="stat-cell">
            <view class="stat-num">{{stats.posts}}</view>
            <view class="stat-label">广场帖子</view>
          </view>
        </view>

        <view class="sec-title">最近注册用户</view>
        <view class="a-card card" wx:for="{{recentUsers}}" wx:key="_id">
          <view class="a-head">
            <view class="a-info">
              <view class="a-title ellipsis">{{item.nickname || '未命名用户'}}</view>
              <view class="a-sub">{{item.phone || '账号：' + (item.username || '—')}} · {{item.timeText}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{!recentUsers.length}}" class="empty card">暂无用户</view>
      </block>
    </block>

    <button wx:if="{{isAdmin}}" class="logout" bindtap="onLogoutAdmin">退出管理员登录</button>
  </block>
</view>
