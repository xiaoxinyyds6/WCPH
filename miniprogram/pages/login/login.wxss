.login {
  min-height: 100vh;
  padding: 60rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #EEF2FF 0%, #F5F6FA 40%);
}

.brand {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.logo {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #6C8CFF 0%, #9B7BFF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  box-shadow: 0 12rpx 30rpx rgba(91, 124, 250, 0.3);
}

.app-name {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-main);
}

.slogan {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

.wx-login {
  width: 100%;
  box-shadow: 0 10rpx 26rpx rgba(91, 124, 250, 0.3);
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0 32rpx;
}

.divider .line {
  flex: 1;
  height: 2rpx;
  background: #E2E5EE;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.form {
  padding: 12rpx 32rpx;
}

.field {
  display: flex;
  align-items: center;
  height: 108rpx;
  border-bottom: 2rpx solid #F0F1F5;
}

.field:last-of-type {
  border-bottom: none;
}

.label {
  width: 130rpx;
  font-size: 28rpx;
  color: var(--text-sub);
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-main);
}

.ph {
  color: #C2C6D0;
}

.code-btn {
  flex: 0 0 auto;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
  margin-left: 16rpx;
}

.code-btn.disabled {
  color: var(--text-light);
  background: #F0F1F5;
}

.remember {
  display: flex;
  align-items: center;
  padding: 24rpx 0 16rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #D5D8E0;
  margin-right: 16rpx;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.remember-text {
  font-size: 25rpx;
  color: var(--text-sub);
}

.submit {
  width: 100%;
  margin-top: 48rpx;
}

.demo-login {
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  margin-top: 28rpx;
}

.agreement {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 32rpx;
}
