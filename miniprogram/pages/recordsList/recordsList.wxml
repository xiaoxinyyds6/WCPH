<view class="page">
  <!-- 分类导航：左=拍照问诊记录，右=文字问诊记录 -->
  <view class="record-tabs">
    <view class="rt-item {{recordTab === 'photo' ? 'active' : ''}}" data-tab="photo" bindtap="onRecordTab">
      📷 拍照问诊报告
    </view>
    <view class="rt-item {{recordTab === 'text' ? 'active' : ''}}" data-tab="text" bindtap="onRecordTab">
      💬 文字图片问诊记录
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <block wx:elif="{{shown.length}}">
    <view class="rec-card card" wx:for="{{shown}}" wx:key="_id" data-id="{{item._id}}" bindtap="onRecordTap">
      <view class="r-avatar">{{item.petAvatar && !item.avatarIsImage ? item.petAvatar : '💬'}}</view>
      <view class="r-info">
        <view class="r-title-line">
          <text class="r-title ellipsis">{{item.petName || item.title || '问诊记录'}}</text>
          <text wx:if="{{item.published}}" class="r-badge">已发布</text>
          <text wx:if="{{item.firstQuestion}}" class="r-question">{{item.firstQuestion}}</text>
        </view>
        <view class="r-desc">{{item.timeText}}</view>
      </view>
      <text class="r-arrow">›</text>
    </view>
  </block>
  <view wx:else class="empty">{{recordTab === 'photo' ? '暂无拍照问诊报告' : '暂无文字图片问诊记录'}}</view>
</view>
