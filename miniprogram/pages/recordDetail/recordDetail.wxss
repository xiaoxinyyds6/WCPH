.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.h-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  flex: 0 0 92rpx;
}

.h-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.h-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.h-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.dialog {
  margin-top: 24rpx;
  padding: 12rpx 28rpx;
}

.line {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F7F3EC;
}

.line:last-child {
  border-bottom: none;
}

.line.user {
  flex-direction: row-reverse;
}

/* 头像 */
.line-avatar {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.line.user .line-avatar {
  background: #EAF4EE;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.line-body {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.line.user .line-body {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.line-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.line-name {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* 紧急程度分级徽标（历史记录） */
.urgency-badge {
  margin-left: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.urgency-badge.red {
  background: #FAEDED;
  color: #D9534F;
  border: 2rpx solid #E5A5A3;
}

.urgency-badge.yellow {
  background: #FBF3E2;
  color: #B8772B;
  border: 2rpx solid #F2CFA0;
}

.urgency-badge.green {
  background: #EAF4EE;
  color: #4CAF7D;
  border: 2rpx solid #BFE3D2;
}

.line.ai .line-name {
  background: var(--primary-soft);
  color: var(--primary);
}

.line.user .line-name {
  background: #EAF4EE;
  color: #4CAF7D;
}

.line.user .urgency-badge {
  margin-left: 0;
  margin-right: 12rpx;
}

.content {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 聊天记录中的图片/视频 */
.msg-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.msg-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: #F7F3EC;
}

.msg-video {
  width: 100%;
  height: 320rpx;
  margin-top: 12rpx;
  border-radius: 14rpx;
  background: #000;
}

.notice {
  text-align: center;
  color: var(--text-light);
  font-size: 22rpx;
  margin: 32rpx 24rpx;
  line-height: 1.6;
}

.consult-btn {
  margin: 40rpx 8rpx 0;
}

.plan-btn {
  margin: 24rpx 8rpx 0;
}

.btn-danger {
  margin: 24rpx 8rpx 0;
  background: #fff;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.8;
  border: 2rpx solid #F5D8D6;
}

.btn-danger::after {
  border: none;
}
