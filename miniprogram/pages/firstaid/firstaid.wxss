.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.head {
  padding: 36rpx 40rpx 8rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 离线横幅 */
.offline-banner {
  margin: 24rpx 32rpx 0;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #EDF5F3 0%, #F0EBFA 100%);
  color: var(--primary);
  font-size: 25rpx;
  display: flex;
  align-items: center;
}

.ob-icon {
  margin-right: 12rpx;
}

/* 指南卡片 */
.guide {
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
}

.g-head {
  display: flex;
  align-items: center;
}

.g-icon {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  border-radius: 24rpx;
  background: #FAEDED;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.g-meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.g-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.g-tag {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
}

.g-arrow {
  flex: 0 0 auto;
  font-size: 32rpx;
  color: var(--text-light);
  padding: 0 8rpx;
}

/* 步骤 */
.g-body {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #F7F3EC;
}

.g-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}

.step-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.step-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-main);
}

.step-desc {
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--text-sub);
}

/* 警告条 */
.g-warning {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #FBF3E2;
  border: 2rpx solid #F2CFA0;
}

.gw-icon {
  margin-right: 10rpx;
}

.gw-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.6;
  color: #B8772B;
}

.g-call {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
  padding: 12rpx 0;
}

.disclaimer {
  margin: 32rpx 40rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}
