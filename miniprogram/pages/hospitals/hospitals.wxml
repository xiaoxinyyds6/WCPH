<view class="page">
  <view class="status card {{located ? 'ok' : ''}}">
    <view wx:if="{{locating}}" class="s-text">📍 正在定位…</view>
    <block wx:elif="{{located}}">
      <view class="s-text">📍 定位成功，已按距离从近到远排序</view>
    </block>
    <block wx:else>
      <view class="s-text">📍 未获取到定位，无法计算距离</view>
      <view class="s-btn" bindtap="onRelocate">重新定位</view>
    </block>
  </view>

  <!-- 地图：显示用户位置与附近医院标记，点击标记可发起导航 -->
  <map
    wx:if="{{markers.length}}"
    class="hosp-map"
    latitude="{{mapLat}}"
    longitude="{{mapLng}}"
    scale="12"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
  >
    <cover-view class="map-loc-btn" bindtap="onRelocate">⌖</cover-view>
  </map>

  <view class="hosp card" wx:for="{{hospitals}}" wx:key="name">
    <view class="h-head">
      <view class="h-icon">🏥</view>
      <view class="h-info">
        <view class="h-title-line">
          <text class="h-name ellipsis">{{item.name}}</text>
          <text wx:if="{{item.tag}}" class="h-tag">{{item.tag}}</text>
        </view>
        <view class="h-addr ellipsis">{{item.addr}}</view>
      </view>
      <view class="h-dist">{{item.distText}}</view>
    </view>
    <view class="h-actions">
      <view class="h-btn" data-phone="{{item.phone}}" bindtap="onCall">📞 拨号</view>
      <view class="h-btn" data-lat="{{item.lat}}" data-lng="{{item.lng}}" data-name="{{item.name}}" data-addr="{{item.addr}}" bindtap="onOpenMap">🗺 导航</view>
    </view>
  </view>

  <view class="tip">医院信息与坐标为演示数据，紧急情况请直接拨打附近宠物医院电话或前往就诊。</view>
</view>
