.page {
  min-height: 100vh;
  padding: 24rpx;
}

.rec-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.r-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex: 0 0 92rpx;
}

.r-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.r-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.r-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

/* 审核状态标签 */
.audit-tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}
.audit-tag.pending {
  background: #FBF3E4;
  color: #B27B23;
}
.audit-tag.rejected {
  background: #FAEDED;
  color: var(--danger);
}

.del-link {
  flex: 0 0 auto;
  font-size: 26rpx;
  color: var(--danger);
  margin-left: 16rpx;
}

.empty {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
  padding: 100rpx 0;
}
