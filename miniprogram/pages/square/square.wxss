.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== 未登录：仅显示居中登录入口 ===== */
.login-gate {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.login-gate-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 48rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 32rpx;
}

.login-gate-title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-main);
}

.login-gate-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.login-gate-btn {
  width: 280rpx;
  margin-top: 48rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--primary) 0%, #6CBFB5 100%);
  box-shadow: 0 8rpx 20rpx rgba(95, 168, 160, 0.28);
  color: #fff;
  font-size: 30rpx;
  line-height: 2.6;
}

/* ===== 顶部标签导航 ===== */
.head {
  padding: 28rpx 32rpx 4rpx;
}

.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tabs {
  display: flex;
  flex: 1;
  align-items: center;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-sub);
  padding: 16rpx 0 22rpx;
  position: relative;
  transition: color 0.2s ease;
}

.tab.active {
  color: var(--text-main);
  font-weight: 700;
  font-size: 32rpx;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 8rpx;
  width: 44rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #63BDB2 0%, #8ECAE6 100%);
}

.msg-entry {
  position: relative;
  padding: 8rpx 4rpx 8rpx 12rpx;
  font-size: 42rpx;
  line-height: 1;
}

.msg-badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--danger);
  border: 2rpx solid var(--bg);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ===== 云端不可用提示条 ===== */
.offline-tip {
  margin: 24rpx 32rpx 0;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  background: #FBF3E2;
  border: 2rpx solid #F2CFA0;
  color: #B8772B;
  font-size: 23rpx;
}

/* ===== 搜索入口 ===== */
.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  padding: 0 28rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: var(--shadow);
  transition: transform 0.18s ease;
}

.search-bar:active {
  transform: scale(0.98);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-ph {
  font-size: 26rpx;
  color: var(--text-light);
}

/* ===== 大厅：推荐 / 最新 分段控件 ===== */
.hall-top {
  padding-bottom: 4rpx;
}

.feed-tabs {
  display: flex;
  margin: 20rpx 32rpx 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #EDF2F1;
}

.feed-tab {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  transition: all 0.2s ease;
}

.feed-tab.active {
  background: #fff;
  color: var(--primary-deep);
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(31, 42, 46, 0.08);
}

/* ===== 帖子卡片 ===== */
.post {
  position: relative;
  margin: 24rpx 32rpx 0;
  padding: 30rpx 28rpx;
  transition: transform 0.18s ease;
}

.post:active {
  transform: scale(0.99);
}

.p-head {
  display: flex;
  align-items: center;
}

.p-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  border-radius: 26rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.p-meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.p-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.p-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.p-title-row .p-title {
  flex: 1;
  min-width: 0;
}

/* 自己的帖子角标：暖杏渐变，与其余标签区分 */
.my-tag {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F4C08B 0%, #E9A94B 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.p-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.part-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 20rpx;
  font-weight: 600;
}

.p-tag {
  flex: 0 0 auto;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EAF4EE;
  color: #4CAF7D;
}

.p-excerpt {
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-main);
}

/* 帖子缩略图 */
.p-img {
  width: 100%;
  height: 320rpx;
  margin-top: 20rpx;
  border-radius: var(--radius-sm);
  background: #F0F3F2;
}

.p-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--hairline);
}

.p-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.p-actions {
  display: flex;
  align-items: center;
}

.p-act {
  margin-left: 28rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 6rpx 10rpx;
}

.p-act.liked {
  color: var(--danger);
}

/* 收藏五角星：空心 ↔ 实心黄 */
.p-act.fav {
  font-size: 30rpx;
  line-height: 1;
}

.p-act.fav-on {
  color: #E9A94B;
}

/* 「⋯」按钮与下拉菜单 */
.p-more {
  margin-left: 28rpx;
  padding: 6rpx 10rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--text-sub);
  letter-spacing: 4rpx;
}

.more-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: transparent;
}

.more-menu {
  position: absolute;
  right: 20rpx;
  bottom: 96rpx;
  z-index: 40;
  background: #fff;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-lift);
  padding: 8rpx 0;
}

.mm-item {
  padding: 18rpx 44rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.mm-item + .mm-item {
  border-top: 2rpx solid var(--hairline);
}

.mm-item:active {
  background: var(--bg);
}

/* ===== 分页加载提示 ===== */
.load-more {
  padding: 32rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}

.empty {
  margin: 24rpx 32rpx;
  padding: 60rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.disclaimer {
  margin: 32rpx 40rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}

/* ===== 右下角发布按钮 ===== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #63BDB2 0%, #4E9E96 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(95, 168, 160, 0.40);
  z-index: 20;
  transition: transform 0.18s ease;
}

.fab:active {
  transform: scale(0.9);
}

.fab-plus {
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -6rpx;
}

/* ===== 从消息页跳转定位时的高亮提示 ===== */
.post.highlight {
  animation: post-flash 2.6s ease;
}

@keyframes post-flash {
  0%, 55% {
    box-shadow: 0 0 0 8rpx rgba(95, 168, 160, 0.35), var(--shadow);
  }
  100% {
    box-shadow: var(--shadow);
  }
}

/* ===== 每日首次进入公告弹框（顶部下拉） ===== */
.notice-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 20, 30, 0.55);
  z-index: 999;
}

.notice-sheet {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  background: #fff;
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-top));
  animation: notice-drop 0.3s ease;
}

@keyframes notice-drop {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}

.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.notice-x {
  font-size: 34rpx;
  color: var(--text-light);
  padding: 8rpx 12rpx;
}

.notice-body {
  margin-top: 20rpx;
}

.notice-line {
  font-size: 27rpx;
  color: var(--text-main);
  line-height: 1.7;
}

.notice-item {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.8;
  margin-top: 8rpx;
}

.notice-warn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #B8772B;
  background: #FBF3E2;
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  line-height: 1.7;
}

.notice-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.notice-check {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid #D8E0DE;
  margin-right: 12rpx;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.notice-check-text {
  font-size: 25rpx;
  color: var(--text-sub);
}

.notice-btn {
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #63BDB2 0%, #4E9E96 100%);
  box-shadow: 0 6rpx 16rpx rgba(95, 168, 160, 0.30);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 官方好帖：浅绿底 + 官方徽标 ===== */
.post.official-post {
  background: linear-gradient(160deg, #F2F8F4 0%, #FFFFFF 100%);
  border: 2rpx solid #D9EBE0;
}

.official-badge {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5CB88A 0%, #4CAF7D 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

/* ===== 精选好帖：主视觉横幅（提示点赞过百上榜） ===== */
.hero {
  position: relative;
  overflow: hidden;
  margin: 24rpx 32rpx 0;
  padding: 48rpx 40rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(130deg, #2F3A3F 0%, #7A6BC9 55%, #9D8CF0 100%);
  box-shadow: 0 16rpx 40rpx rgba(122, 107, 201, 0.32);
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.hero-deco.d1 {
  width: 260rpx;
  height: 260rpx;
  top: -120rpx;
  right: -60rpx;
}

.hero-deco.d2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -70rpx;
  left: 30%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-deco.d3 {
  width: 80rpx;
  height: 80rpx;
  top: 40rpx;
  left: 46%;
  background: rgba(232, 196, 104, 0.25);
}

.hero-icon {
  position: relative;
  font-size: 56rpx;
  line-height: 1;
}

.hero-title {
  position: relative;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #fff;
}

.hero-sub {
  position: relative;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ===== 精选好帖：前三名金/银/铜配色 ===== */
.post.top1 {
  border: 2rpx solid #EED491;
  box-shadow: 0 10rpx 30rpx rgba(230, 162, 60, 0.22);
  background: linear-gradient(180deg, #FDF9EE 0%, #FFFFFF 100%);
}

.post.top2 {
  border: 2rpx solid #D8E0E4;
  box-shadow: 0 8rpx 26rpx rgba(150, 165, 190, 0.20);
  background: linear-gradient(180deg, #F8FAFB 0%, #FFFFFF 100%);
}

.post.top3 {
  border: 2rpx solid #F2C9A0;
  box-shadow: 0 8rpx 26rpx rgba(215, 150, 90, 0.18);
  background: linear-gradient(180deg, #FBF6F1 0%, #FFFFFF 100%);
}

.rank-badge {
  position: absolute;
  top: -22rpx;
  left: -8rpx;
  font-size: 52rpx;
  line-height: 1;
  z-index: 5;
}

/* 精选帖热度标签 */
.hot-tag {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #E2655F 0%, #D24B47 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(217, 83, 79, 0.30);
}
