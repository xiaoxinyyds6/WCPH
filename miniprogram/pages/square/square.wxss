.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 未登录：仅显示居中登录入口 */
.login-gate {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.login-gate-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 28rpx;
}

.login-gate-title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-main);
}

.login-gate-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.login-gate-btn {
  width: 280rpx;
  margin-top: 48rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  line-height: 2.6;
}

.login-gate-btn::after {
  border: none;
}

/* 顶部 */
.head {
  padding: 36rpx 40rpx 8rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 头部：标题 + 信封入口 */
.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.msg-entry {
  position: relative;
  padding: 8rpx 12rpx 8rpx 0;
  font-size: 44rpx;
  line-height: 1;
}

.msg-badge {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 精选好帖入口 */
.featured-entry {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FBF3E2 0%, #FAEDED 100%);
  border: 2rpx solid #F2CFA0;
  color: #B8772B;
  font-size: 24rpx;
  font-weight: 600;
}

.fe-arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
}

/* 云端不可用提示条 */
.offline-tip {
  margin: 24rpx 32rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #FBF3E2;
  border: 2rpx solid #F2CFA0;
  color: #B8772B;
  font-size: 23rpx;
}

/* 大厅：推荐 / 最新 */
.feed-tabs {
  display: flex;
  margin: 20rpx 32rpx 0;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #F3F8F7;
}

/* 搜索入口 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  padding: 0 24rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(47, 58, 63, 0.08);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-ph {
  font-size: 26rpx;
  color: var(--text-light);
}

.feed-tab {
  flex: 1;
  padding: 12rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
}

.feed-tab.active {
  background: #fff;
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 36, 48, 0.06);
}

/* 帖子卡片 */
.post {
  position: relative;
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
}

.p-head {
  display: flex;
  align-items: center;
}

.p-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.p-meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.p-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.p-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.p-title-row .p-title {
  flex: 1;
  min-width: 0;
}

/* 自己的帖子角标：暖杏渐变，与其余标签区分 */
.my-tag {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F2B880 0%, #E6A23C 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.p-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

.part-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
}

.demo-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #F7F3EC;
  color: var(--text-light);
  font-size: 20rpx;
}

.p-tag {
  flex: 0 0 auto;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EAF4EE;
  color: #4CAF7D;
}

.p-excerpt {
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-main);
}

/* 帖子缩略图 */
.p-img {
  width: 100%;
  height: 320rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #F7F3EC;
}

.p-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.p-time {
  font-size: 22rpx;
  color: var(--text-light);
}

.p-actions {
  display: flex;
  align-items: center;
}

.p-act {
  margin-left: 28rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 6rpx 10rpx;
}

.p-act.liked {
  color: #D9534F;
}

/* 收藏五角星：空心 ↔ 实心黄 */
.p-act.fav {
  font-size: 30rpx;
  line-height: 1;
}

.p-act.fav-on {
  color: #E6A23C;
}

/* 「⋯」按钮与下拉菜单 */
.p-more {
  margin-left: 28rpx;
  padding: 6rpx 10rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--text-sub);
  letter-spacing: 4rpx;
}

.more-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: transparent;
}

.more-menu {
  position: absolute;
  right: 20rpx;
  bottom: 88rpx;
  z-index: 40;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 36, 48, 0.18);
  padding: 8rpx 0;
}

.mm-item {
  padding: 16rpx 44rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.mm-item + .mm-item {
  border-top: 2rpx solid #FAF8F5;
}

.mm-item:active {
  background: #FAF8F5;
}

/* 分页加载提示 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}

.empty {
  margin: 24rpx 32rpx;
  padding: 60rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.disclaimer {
  margin: 32rpx 40rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}

.ph {
  color: var(--text-light);
}

/* 右下角发布按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, #6CBFB5 0%, #A78BFA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(107, 191, 181, 0.4);
  z-index: 20;
}

.fab-plus {
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -6rpx;
}

/* 从消息页跳转定位时的高亮提示 */
.post.highlight {
  animation: post-flash 2.6s ease;
}

@keyframes post-flash {
  0%, 55% {
    box-shadow: 0 0 0 8rpx rgba(95, 168, 160, 0.35), 0 8rpx 30rpx rgba(95, 168, 160, 0.12);
  }
  100% {
    box-shadow: 0 8rpx 30rpx rgba(95, 168, 160, 0.08);
  }
}

/* 每日首次进入公告弹框（顶部下拉） */
.notice-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 20, 30, 0.55);
  z-index: 999;
}

.notice-sheet {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  background: #fff;
  border-radius: 0 0 32rpx 32rpx;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-top));
  animation: notice-drop 0.3s ease;
}

@keyframes notice-drop {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}

.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.notice-x {
  font-size: 34rpx;
  color: var(--text-light);
  padding: 8rpx 12rpx;
}

.notice-body {
  margin-top: 20rpx;
}

.notice-line {
  font-size: 27rpx;
  color: var(--text-main);
  line-height: 1.7;
}

.notice-item {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.8;
  margin-top: 8rpx;
}

.notice-warn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #B8772B;
  background: #FBF3E2;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  line-height: 1.7;
}

.notice-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.notice-check {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #D8E0DE;
  margin-right: 12rpx;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.notice-check-text {
  font-size: 25rpx;
  color: var(--text-sub);
}

.notice-btn {
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6CBFB5 0%, #A78BFA 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 三标签导航（问诊大厅 / 精选好帖 / 官方好帖） */
.tabs {
  display: flex;
  flex: 1;
  align-items: center;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-sub);
  padding: 16rpx 0 20rpx;
  position: relative;
}

.tab.active {
  color: var(--primary);
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 6rpx;
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #6CBFB5 0%, #A78BFA 100%);
}

/* 官方好帖：区别于大厅/精选的卡片样式（浅绿底 + 官方徽标） */
.post.official-post {
  background: linear-gradient(160deg, #EAF4EE 0%, #EAF4EE 100%);
  border: 2rpx solid #CFE8DB;
}

.official-badge {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4CAF7D 0%, #4CAF7D 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

/* ===== 精选好帖：主视觉横幅（提示点赞过百上榜） ===== */
.hero {
  position: relative;
  overflow: hidden;
  margin: 24rpx 32rpx 0;
  padding: 48rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2F3A3F 0%, #8B7BD8 45%, #A78BFA 100%);
  box-shadow: 0 16rpx 40rpx rgba(139, 123, 216, 0.35);
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.hero-deco.d1 {
  width: 260rpx;
  height: 260rpx;
  top: -120rpx;
  right: -60rpx;
}

.hero-deco.d2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -70rpx;
  left: 30%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-deco.d3 {
  width: 80rpx;
  height: 80rpx;
  top: 40rpx;
  left: 46%;
  background: rgba(232, 196, 104, 0.25);
}

.hero-icon {
  font-size: 56rpx;
  line-height: 1;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #fff;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ===== 精选好帖：前三名金/银/铜配色 ===== */
.post.top1 {
  border: 2rpx solid #E8C468;
  box-shadow: 0 10rpx 30rpx rgba(230, 162, 60, 0.28);
  background: linear-gradient(180deg, #FBF6E8 0%, #FFFFFF 100%);
}

.post.top2 {
  border: 2rpx solid #CFDAD9;
  box-shadow: 0 8rpx 26rpx rgba(150, 165, 190, 0.25);
  background: linear-gradient(180deg, #FAF8F5 0%, #FFFFFF 100%);
}

.post.top3 {
  border: 2rpx solid #F2B880;
  box-shadow: 0 8rpx 26rpx rgba(215, 150, 90, 0.22);
  background: linear-gradient(180deg, #FAF8F5 0%, #FFFFFF 100%);
}

.rank-badge {
  position: absolute;
  top: -22rpx;
  left: -8rpx;
  font-size: 52rpx;
  line-height: 1;
  z-index: 5;
}

/* 精选帖热度标签 */
.hot-tag {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D9534F 0%, #D9534F 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(217, 83, 79, 0.35);
}
