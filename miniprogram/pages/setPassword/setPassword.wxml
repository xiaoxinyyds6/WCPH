<view class="page">
  <view class="header">
    <view class="title">{{mode === 'reset' ? '重置密码' : '设置密码'}}</view>
    <view class="desc">{{mode === 'reset' ? '请为账号设置新的登录密码' : '首次登录，请设置账号密码'}}</view>
  </view>

  <view class="form card">
    <view class="field">
      <text class="label">{{mode === 'reset' ? '新密码' : '密码'}}</text>
      <input class="input" password="{{!showPwd}}" maxlength="14" placeholder="请输入密码" placeholder-class="ph" value="{{password}}" bindinput="onPasswordInput" />
      <text class="pwd-eye" bindtap="togglePwd">{{showPwd ? '🙈' : '👁'}}</text>
    </view>
    <view wx:if="{{pwdStrength === 'medium'}}" class="pwd-strength warn">⚠️ 该密码安全性一般</view>
    <view wx:if="{{pwdStrength === 'strong'}}" class="pwd-strength good">✅ 该密码的安全性很可靠！</view>
    <view class="field">
      <text class="label">确认密码</text>
      <input class="input" password="{{!showConfirmPwd}}" maxlength="14" placeholder="请再次输入密码" placeholder-class="ph" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
      <text class="pwd-eye" bindtap="toggleConfirmPwd">{{showConfirmPwd ? '🙈' : '👁'}}</text>
    </view>
  </view>

  <view class="password-tip">密码需为8-14位，须同时包含英文和数字，可包含特殊符号</view>
  <button class="btn-primary submit" loading="{{saving}}" disabled="{{saving}}" bindtap="onSubmit">{{mode === 'reset' ? '确认重置' : '完成设置'}}</button>
</view>
