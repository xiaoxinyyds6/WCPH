.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 宠物选择区外框 */
.pet-section {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 20rpx 8rpx;
}

.pet-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  padding-left: 8rpx;
  margin-bottom: 8rpx;
}

/* 宠物横向栏 */
.pet-bar {
  white-space: nowrap;
  padding: 12rpx 8rpx 20rpx;
}

.pet-item {
  display: inline-block;
  position: relative;
  width: 132rpx;
  margin-right: 24rpx;
  text-align: center;
  vertical-align: top;
}

/* 删除模式徽标：头像右上角红色小圆 + 白色横线 */
.del-badge {
  position: absolute;
  top: -6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #D9534F;
  border: 2rpx solid #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.del-badge-line {
  width: 18rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #fff;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(95, 168, 160, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.add-avatar {
  border: 2rpx dashed var(--primary-light);
  background: #fff;
}

.plus {
  font-size: 52rpx;
  color: var(--primary);
  line-height: 1;
  margin-top: -6rpx;
}

/* 删除框：尺寸、虚线圆、布局与添加框一致，仅图标红色区分 */
.del-avatar {
  border-color: #E5A5A3;
}

.del-plus {
  color: #D9534F;
}

.pet-name {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 顶部品牌卡片容器 */
.hero-wrap {
  padding: 24rpx 32rpx 0;
}

/* 介绍区 */
.intro {
  padding: 8rpx 32rpx 0;
}

.hero {
  padding: 44rpx 36rpx;
  background: linear-gradient(135deg, #6CBFB5 0%, #A78BFA 100%);
  color: #fff;
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 26rpx;
  line-height: 1.7;
  opacity: 0.94;
}

.tip-card {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 28rpx;
  margin-top: 24rpx;
}

.tip-icon {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  border-radius: 22rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 22rpx;
}

.tip-body {
  flex: 1;
  min-width: 0;
}

.tip-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.65;
}

.disclaimer {
  text-align: center;
  color: var(--text-light);
  font-size: 22rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
}

/* 问诊入口按钮组：左=症状拍照问诊，右=文字问诊，正方形大按钮 */
.consult-actions {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 8rpx;
}

.btn-photo,
.btn-text {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 320rpx;
  border-radius: 24rpx;
  border: none;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.5;
  font-weight: 600;
}

.btn-photo::after,
.btn-text::after {
  border: none;
}

.btn-photo {
  background: linear-gradient(135deg, #F2B880 0%, #E6A23C 100%);
  box-shadow: 0 10rpx 24rpx rgba(242, 184, 128, 0.35);
}

.btn-text {
  margin-left: 24rpx;
  background: linear-gradient(135deg, #6CBFB5 0%, #5FA8A0 100%);
  box-shadow: 0 10rpx 24rpx rgba(95, 168, 160, 0.3);
}

.btn-emoji {
  font-size: 64rpx;
  line-height: 1.2;
  margin-bottom: 12rpx;
}

.btn-label {
  font-size: 28rpx;
  text-align: center;
}

/* 急救指南入口（按钮组下方，急救红渐变，醒目） */
.firstaid-entry {
  display: flex;
  align-items: center;
  margin: 28rpx 32rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #D9534F 0%, #C9605C 100%);
  box-shadow: 0 12rpx 30rpx rgba(217, 83, 79, 0.3);
}

.fa-icon {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.fa-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.fa-title {
  font-size: 33rpx;
  font-weight: 700;
  color: #fff;
}

.fa-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
}

.fa-badge {
  flex: 0 0 auto;
  margin-right: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #D9534F;
  font-size: 20rpx;
  font-weight: 700;
}

.fa-arrow {
  flex: 0 0 auto;
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 0 8rpx;
}
