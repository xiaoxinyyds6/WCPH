.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 宠物选择区外框 */
.pet-section {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 20rpx 8rpx;
}

.pet-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  padding-left: 8rpx;
  margin-bottom: 8rpx;
}

/* 宠物横向栏 */
.pet-bar {
  white-space: nowrap;
  padding: 12rpx 8rpx 20rpx;
}

.pet-item {
  display: inline-block;
  width: 132rpx;
  margin-right: 24rpx;
  text-align: center;
  vertical-align: top;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(91, 124, 250, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.add-avatar {
  border: 2rpx dashed var(--primary-light);
  background: #fff;
}

.plus {
  font-size: 52rpx;
  color: var(--primary);
  line-height: 1;
  margin-top: -6rpx;
}

.pet-name {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 介绍区 */
.intro {
  padding: 8rpx 32rpx 0;
}

.hero {
  padding: 44rpx 36rpx;
  background: linear-gradient(135deg, #6C8CFF 0%, #9B7BFF 100%);
  color: #fff;
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 26rpx;
  line-height: 1.7;
  opacity: 0.94;
}

.tip-card {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 28rpx;
  margin-top: 24rpx;
}

.tip-icon {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  border-radius: 22rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 22rpx;
}

.tip-body {
  flex: 1;
  min-width: 0;
}

.tip-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.65;
}

.disclaimer {
  text-align: center;
  color: var(--text-light);
  font-size: 22rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
}

.footer-space {
  height: 160rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245,246,250,0) 0%, #F5F6FA 30%);
}

.fab-btn {
  width: 100%;
  box-shadow: 0 10rpx 28rpx rgba(91, 124, 250, 0.35);
}
