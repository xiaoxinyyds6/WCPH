.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== 顶部品牌卡片 ===== */
.hero-wrap {
  padding: 24rpx 32rpx 0;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 48rpx 40rpx 52rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(130deg, #3F9189 0%, #63BDB2 52%, #8FD0CE 100%);
  box-shadow: 0 16rpx 40rpx rgba(95, 168, 160, 0.32);
  color: #fff;
}

/* 装饰光斑（伪元素，无需改结构） */
.hero::before {
  content: '';
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  top: -150rpx;
  right: -80rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero::after {
  content: '';
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  bottom: -90rpx;
  left: -40rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge {
  position: relative;
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  margin-bottom: 22rpx;
}

.hero-title {
  position: relative;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.hero-sub {
  position: relative;
  font-size: 25rpx;
  line-height: 1.7;
  opacity: 0.92;
}

/* ===== 宠物选择区 ===== */
.pet-section {
  margin: 24rpx 32rpx 0;
  padding: 26rpx 20rpx 10rpx;
}

.pet-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  padding-left: 10rpx;
  margin-bottom: 8rpx;
}

/* 宠物横向栏 */
.pet-bar {
  white-space: nowrap;
  padding: 12rpx 8rpx 22rpx;
}

.pet-item {
  display: inline-block;
  position: relative;
  width: 132rpx;
  margin-right: 24rpx;
  text-align: center;
  vertical-align: top;
}

/* 删除模式徽标：头像右上角红色小圆 + 白色横线 */
.del-badge {
  position: absolute;
  top: -6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--danger);
  border: 2rpx solid #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.del-badge-line {
  width: 18rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #fff;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(31, 42, 46, 0.08);
  border: 4rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: transform 0.18s ease;
}

.pet-item:active .avatar {
  transform: scale(0.92);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.add-avatar {
  border: 2rpx dashed #C9DEDA;
  background: #F7FAFA;
}

.plus {
  font-size: 52rpx;
  color: var(--primary);
  line-height: 1;
  margin-top: -6rpx;
}

/* 删除框：尺寸、虚线圆、布局与添加框一致，仅图标红色区分 */
.del-avatar {
  border-color: #EFC4C2;
  background: #FDF7F7;
}

.del-plus {
  color: var(--danger);
}

.pet-name {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* ===== 问诊入口按钮组：左=症状拍照问诊，右=文字问诊 ===== */
.consult-actions {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 8rpx;
}

.btn-photo,
.btn-text {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 300rpx;
  border-radius: var(--radius-lg);
  border: none;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.5;
  font-weight: 600;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.btn-photo:active,
.btn-text:active {
  transform: scale(0.96);
}

.btn-photo {
  background: linear-gradient(140deg, #F4C08B 0%, #E9A94B 100%);
  box-shadow: 0 12rpx 28rpx rgba(233, 169, 75, 0.32);
}

.btn-text {
  margin-left: 24rpx;
  background: linear-gradient(140deg, #63BDB2 0%, #4E9E96 100%);
  box-shadow: 0 12rpx 28rpx rgba(95, 168, 160, 0.30);
}

/* emoji 置于毛玻璃圆片之上 */
.btn-emoji {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  line-height: 1;
  margin-bottom: 18rpx;
}

.btn-label {
  font-size: 28rpx;
  text-align: center;
}

/* ===== 急救指南入口（急救红渐变，醒目） ===== */
.firstaid-entry {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  margin: 28rpx 32rpx 0;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #E2655F 0%, #D24B47 100%);
  box-shadow: 0 12rpx 30rpx rgba(217, 83, 79, 0.28);
  transition: transform 0.18s ease;
}

.firstaid-entry:active {
  transform: scale(0.98);
}

.firstaid-entry::before {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  top: -140rpx;
  right: -60rpx;
  background: rgba(255, 255, 255, 0.10);
}

.fa-icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.20);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.fa-body {
  position: relative;
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.fa-title {
  font-size: 33rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.fa-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
}

.fa-badge {
  position: relative;
  flex: 0 0 auto;
  margin-right: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #D24B47;
  font-size: 20rpx;
  font-weight: 700;
}

.fa-arrow {
  position: relative;
  flex: 0 0 auto;
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 0 8rpx;
}

/* ===== 介绍区 ===== */
.intro {
  padding: 8rpx 32rpx 0;
}

.tip-card {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 28rpx;
  margin-top: 24rpx;
  transition: transform 0.18s ease;
}

.tip-card:active {
  transform: scale(0.98);
}

.tip-icon {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 22rpx;
}

/* 大厂风格彩色图标底：按顺序轮换柔和色板 */
.tip-card:nth-of-type(2) .tip-icon { background: #FFF4E3; }
.tip-card:nth-of-type(3) .tip-icon { background: #F0EBFB; }
.tip-card:nth-of-type(4) .tip-icon { background: #EAF4EE; }
.tip-card:nth-of-type(5) .tip-icon { background: #FDEEEE; }

.tip-body {
  flex: 1;
  min-width: 0;
}

.tip-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.65;
}

.disclaimer {
  text-align: center;
  color: var(--text-light);
  font-size: 22rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
}
