.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 分组标题 */
.form-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  padding: 24rpx 0 12rpx;
}

.form-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--primary);
  margin-right: 12rpx;
}

/* 头像区（嵌入基础信息卡片内） */
.avatar-section {
  padding: 8rpx 0 24rpx;
  text-align: center;
  border-bottom: 2rpx solid #F0F1F5;
}

.avatar-preview {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 88rpx;
  line-height: 1;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
}

.avatar-tip {
  font-size: 24rpx;
  color: var(--text-light);
  margin: 20rpx 0 24rpx;
}

.avatar-list {
  white-space: nowrap;
}

.avatar-option {
  display: inline-block;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 46rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background: #F5F6FA;
  border: 3rpx solid transparent;
}

.avatar-option.active {
  border-color: var(--primary);
  background: var(--primary-soft);
}

/* 表单 */
.form {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
}

.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 2rpx solid #F0F1F5;
}

.row.column {
  flex-direction: column;
  align-items: flex-start;
  padding: 8rpx 0;
  min-height: 0;
}

.row.column .row-label {
  flex: 0 0 auto;
  width: auto;
  margin-bottom: 10rpx;
}

/* 列布局下选项区不参与拉伸，避免整行被撑高 */
.row.column .chips {
  flex: none;
  width: 100%;
}

/* 选项等宽平铺，占满整行 */
.row.column .chip {
  flex: 1;
  text-align: center;
  margin: 6rpx 12rpx 0 0;
}

.row.column .chip:last-child {
  margin-right: 0;
}

.row.last {
  border-bottom: none;
}

.row-inner {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 104rpx;
}

.row-label {
  width: 170rpx;
  flex: 0 0 170rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.row-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text-main);
}

.row-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: var(--text-main);
}

.arrow {
  margin-left: 12rpx;
  color: var(--text-light);
  font-size: 34rpx;
}

.ph {
  color: #C2C6D0;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.row .chips {
  flex: 1;
  justify-content: flex-end;
}

.chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #F2F3F7;
  color: var(--text-sub);
  font-size: 24rpx;
  margin: 6rpx 0 6rpx 14rpx;
}

.chip.active {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

/* 操作按钮 */
.actions {
  margin-top: 48rpx;
  padding: 0 8rpx;
}

.btn-danger {
  margin-top: 24rpx;
  background: #fff;
  color: var(--danger);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.6;
  border: 2rpx solid #FFD9DA;
}

.btn-danger::after {
  border: none;
}
