/* 全局样式与设计变量 */
page {
  --primary: #5FA8A0;
  --primary-deep: #4A8B84;
  --primary-light: #8ECAE6;
  --primary-soft: #EDF5F3;
  --text-main: #1F2A2E;
  --text-sub: #6B7A80;
  --text-light: #9AA8AD;
  --bg: #F7F8F7;
  --card: #FFFFFF;
  --danger: #E25C58;
  --warn: #E6A23C;
  --radius-sm: 16rpx;
  --radius: 24rpx;
  --radius-lg: 32rpx;
  /* 大厂风格：低透明度、大扩散的双层阴影 */
  --shadow: 0 2rpx 6rpx rgba(31, 42, 46, 0.03), 0 12rpx 32rpx rgba(31, 42, 46, 0.06);
  --shadow-lift: 0 4rpx 12rpx rgba(31, 42, 46, 0.05), 0 20rpx 48rpx rgba(31, 42, 46, 0.10);
  --hairline: #EEF2F1;

  background-color: var(--bg);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  line-height: 1.6;
}

view, text, scroll-view, navigator, button, input, textarea, image {
  box-sizing: border-box;
}

/* 全局去除按钮默认边框 */
button::after {
  border: none;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

/* 可点卡片的按压反馈 */
.tap-active {
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.tap-active:active {
  transform: scale(0.97);
  opacity: 0.88;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  line-height: 2.6;
  box-shadow: 0 8rpx 20rpx rgba(95, 168, 160, 0.28);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 10rpx rgba(95, 168, 160, 0.20);
}

.btn-plain {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.4;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.btn-plain:active {
  transform: scale(0.97);
  opacity: 0.85;
}

.text-sub { color: var(--text-sub); }
.text-light { color: var(--text-light); }
.text-primary { color: var(--primary); }
.text-danger { color: var(--danger); }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.empty {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 密码框可见性切换按钮 */
.pwd-eye {
  flex: 0 0 auto;
  padding: 16rpx 8rpx 16rpx 20rpx;
  font-size: 34rpx;
  line-height: 1;
}

/* 密码强度提示 */
.pwd-strength {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx 10rpx;
  font-size: 22rpx;
}

.pwd-strength.warn {
  color: #E6A23C;
}

.pwd-strength.good {
  color: #07C160;
}
