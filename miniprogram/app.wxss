/* 全局样式与设计变量 */
page {
  --primary: #5FA8A0;
  --primary-light: #8ECAE6;
  --primary-soft: #EDF5F3;
  --text-main: #2F3A3F;
  --text-sub: #6B7A80;
  --text-light: #6B7A80;
  --bg: #FAF8F5;
  --card: #FFFFFF;
  --danger: #D9534F;
  --warn: #E6A23C;
  --radius: 24rpx;
  --shadow: 0 8rpx 30rpx rgba(95, 168, 160, 0.08);

  background-color: var(--bg);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  line-height: 1.6;
}

view, text, scroll-view, navigator, button, input, textarea, image {
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  line-height: 2.6;
}

.btn-primary::after {
  border: none;
}

.btn-plain {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 2.4;
}

.btn-plain::after {
  border: none;
}

.text-sub { color: var(--text-sub); }
.text-light { color: var(--text-light); }
.text-primary { color: var(--primary); }
.text-danger { color: var(--danger); }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.empty {
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 密码框可见性切换按钮 */
.pwd-eye {
  flex: 0 0 auto;
  padding: 16rpx 8rpx 16rpx 20rpx;
  font-size: 34rpx;
  line-height: 1;
}

/* 密码强度提示 */
.pwd-strength {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx 10rpx;
  font-size: 22rpx;
}

.pwd-strength.warn {
  color: #E6A23C;
}

.pwd-strength.good {
  color: #07C160;
}
